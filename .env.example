# Use exactly 32 characters and store the production value outside Git.
PB_ENCRYPTION_KEY=replace-with-32-random-characters

# Optional on first production migration. Keep both values server-only.
# The password must be at least 24 characters.
PB_SUPERUSER_EMAIL=recovery@example.com
PB_SUPERUSER_PASSWORD=replace-with-a-long-random-password

# Optional local binding override used by scripts/start.mjs.
PB_PORT=8090

# Optional ignored data location used for isolated local/integration runs.
PB_DATA_DIRECTORY=pb_data
