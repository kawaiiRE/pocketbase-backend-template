# Copy to .env for local development (`corepack yarn dev` and `corepack yarn seed` load it).
# In production, provide these through the deployment's private environment, never Git.

# --- Core ---------------------------------------------------------------------------------

# Settings encryption key: exactly 32 characters. Required in production; optional locally.
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# Backups need the same key to recover encrypted settings (SMTP password, etc.).
# PB_ENCRYPTION_KEY=

# Recovery superuser created by the foundation migration on a fresh database only.
# Password must be at least 24 characters. Locally these also authenticate `yarn seed`.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=local-only-superuser-password-change-me

# Local binding and ignored data directory used by scripts/start.mjs.
PB_PORT=8090
PB_DATA_DIRECTORY=pb_data

# --- Public features (GET /api/v1/config) -------------------------------------------------

# Allows POST /api/v1/auth/register. Closed by default.
PB_REGISTRATION_ENABLED=false

# Blocks sign-in for unverified users and sends a verification email on registration.
# Requires working SMTP. Keep false locally unless you run Mailpit (see below).
PB_REQUIRE_EMAIL_VERIFICATION=false

# Allows POST /api/v1/auth/guest ("continue as guest"). Closed by default.
PB_GUEST_ENABLED=false
# Hours a guest account lives before the hourly cleanup deletes it with its notes.
# 0.01 through 720; fractions are allowed for testing. Applies even when guests are disabled.
PB_GUEST_TTL_HOURS=24

# --- App name, email links, and sender (applied at every start when set) ------------------

# {APP_NAME} in email subjects and bodies. Unset keeps the stored name.
# PB_APP_NAME=Example App

# Frontend origin used as {APP_URL} in emails: /verify-email?token=..., /reset-password?token=...
PB_APP_URL=http://localhost:3000
# PB_MAIL_SENDER_NAME=Example App
# PB_MAIL_SENDER_ADDRESS=no-reply@example.com

# --- SMTP (applied at every start when PB_SMTP_HOST is set) -------------------------------
# Local development with Mailpit (https://mailpit.axllent.org):
#   docker run --rm -p 8025:8025 -p 1025:1025 axllent/mailpit   (inbox at http://localhost:8025)
# PB_SMTP_HOST=127.0.0.1
# PB_SMTP_PORT=1025
# Production example (TLS defaults to true on port 465, STARTTLS is used on 587):
# PB_SMTP_HOST=smtp.example.com
# PB_SMTP_PORT=587
# PB_SMTP_USERNAME=
# PB_SMTP_PASSWORD=
# PB_SMTP_TLS=false
# PB_SMTP_AUTH_METHOD=PLAIN

# --- Gateway ------------------------------------------------------------------------------

# Header(s) carrying the real client IP, set (overwritten, not appended) by the trusted gateway.
# Needed for per-client rate limits behind Next.js. Only set when PocketBase is private.
# PB_TRUSTED_PROXY_HEADERS=X-Forwarded-For

# --- Local seed (corepack yarn seed) ------------------------------------------------------

# Refuses non-loopback targets, NODE_ENV=production, and instances whose app URL is not local.
# PB_SEED_URL=http://127.0.0.1:8090
# PB_SEED_DEMO_EMAIL=demo@example.com
# PB_SEED_DEMO_PASSWORD=demo-password-123
